{
  "name": "@tiny-electrons/voxissue-sdk",
  "version": "0.2.0",
  "description": "VoxIssue SDK: self-driving in-SPA visual capture + regression runner, with native shutter hooks for the VoxIssue iOS app. Framework-agnostic core, swappable capture engine, thin Vue adapter.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "author": "Tiny Electrons LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiny-Electrons-LLC/VoxIssue.git",
    "directory": "sdk"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:build": "npm run test && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "modern-screenshot": "^4.6.6"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  }
}